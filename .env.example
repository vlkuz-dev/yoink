YOINK_BOT_TOKEN=
YOINK_LOG_LEVEL=INFO
YOINK_LOG_FORMAT=json
YOINK_WORKERS=4
YOINK_QUEUE_MAXSIZE=64
YOINK_DOWNLOAD_TIMEOUT_S=90
YOINK_MAX_FILE_MB=50
YOINK_RATE_PER_CHAT_PER_MIN=10
YOINK_RATE_PER_USER_PER_HOUR=5
YOINK_ALLOWLIST_MODE=true
YOINK_ADMIN_IDS=
# Comma-separated chat IDs (signed ints; groups are negative) the bot will
# answer URL messages in. Empty = deny all (bot silent everywhere).
# Admin commands stay gated by YOINK_ADMIN_IDS regardless of this list.
YOINK_CHAT_ALLOWLIST=
YOINK_CACHE_DB=/data/yoink.sqlite
YOINK_WORKDIR=/tmp/yoink
YOINK_IG_COOKIES_FILE=
